# Copy this file to .env before running the project:  cp .env.example .env
# config/settings.py reads these via python-decouple. DJANGO_SECRET_KEY and
# REDIS_URL have no defaults, so the server will not start until .env exists.

# Any non-empty string works for local dev. Generate a fresh one for anything
# that leaves your machine:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY='django-insecure-change-me-for-anything-public'

# True enables Django debug pages. Accepts true/false/1/0/yes/no/dev/prod.
DEBUG=True

# Leave permissive for local exploration; use an explicit allowlist in production.
CORS_ALLOW_ALL_ORIGINS=True

# Only the optional jobs queue endpoint needs a running Redis. The value just
# has to be present for settings to import — Redis itself is optional otherwise.
REDIS_URL=redis://127.0.0.1:6379/0
