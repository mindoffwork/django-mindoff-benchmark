            },
            "url": {
              "raw": "{{base_url}}/v1/catalog/run_product_benchmark/",
              "host": ["{{base_url}}"],
              "path": ["v1", "catalog", "run_product_benchmark", ""]
            },
            "description": "Runs one serialized DRF serializer many=True vs Mindoff create/read/update benchmark and writes CSV plus time-line, memory-line, per-count time-bar, and per-count memory-bar PNG artifacts under output/."
